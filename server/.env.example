PORT=5000
# Comma-separated list of allowed browser origins (express + socket.io)
CORS_ORIGIN=http://localhost:3000,https://localhost:3000
# Max concurrent ffmpeg processes (optional, default 10)
# MAX_STREAMS=10
# Set to 1 to stamp input with wallclock time (off by default; can cause audio jitter)
# WALLCLOCK_TIMESTAMPS=0
